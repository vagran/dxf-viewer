{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    //
    // The test tasks need nothing but `npm install` in this folder: no browser, no dev server and
    // no DXF corpus. Add a task here whenever a new script lands in package.json.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm link",
            "type": "process",
            "command": "npm",
            "args": ["link"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "npm publish",
            "type": "process",
            "command": "npm",
            "args": ["publish"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            // Bound to "Tasks: Run Test Task", so it runs without picking from the list.
            "label": "test",
            "type": "process",
            "command": "npm",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            // Re-runs on save. Node watches the files the tests touch, which includes src/.
            "label": "test (watch)",
            "type": "process",
            "command": "node",
            "args": ["--test", "--watch", "test/**/*.test.mjs"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            // The test file in the active editor, for when the whole suite is more than you want.
            "label": "test (current file)",
            "type": "process",
            "command": "node",
            "args": ["--test", "${relativeFile}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Queries the DXF corpora - "which files have X". See test/tools/dxfq.py for the
            // expression vocabulary; --raw needs nothing but Python.
            "label": "query corpus",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": ["test/tools/dxfq.py", "${input:dxfQuery}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Rebuilds the content index of test-data/sample-files/ and reports what moved since
            // the last run. Needs nothing but Python. See test/tools/dxfidx.py.
            "label": "index corpus",
            "type": "process",
            "command": "python3",
            "args": ["test/tools/dxfidx.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // "Do we already have this drawing?" - takes the file itself, a sha256 prefix or a
            // name. Drop an attachment from an issue in here before adding it to the corpus.
            "label": "index corpus (find)",
            "type": "process",
            "command": "python3",
            "args": ["test/tools/dxfidx.py", "find", "${input:corpusQuery}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Renders a DXF to SVG through SceneReader and writes it next to the input. A review
            // aid, not a test: see test/svg.mjs.
            "label": "svg",
            "type": "process",
            "command": "npm",
            "args": ["run", "svg", "--", "${input:dxfPath}", "--font", "test-data/fonts/Roboto-LightItalic.ttf"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Builds every drawing in test-data/ (or test/fixtures/ when it is absent) and reports
            // warnings, validation failures and the numbers worth diffing across a change.
            "label": "smoke",
            "type": "process",
            "command": "node",
            "args": ["--max-old-space-size=6144", "test/smoke.mjs"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Accepts the current scene dumps as correct. Read the resulting diff before
            // committing it: a golden regenerated without being read is worse than no test.
            "label": "test (update goldens)",
            "type": "process",
            "command": "npm",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "DXF_UPDATE_GOLDENS": "1"
                }
            },
            "problemMatcher": []
        },
        {
            // Rewrites test/fixtures/*.dxf from their generator. Needs the venv; see
            // test/fixtures/README.md.
            "label": "fixtures (regenerate)",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": ["test/fixtures/gen/generate.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Reports formatting deviations without touching anything. Only @stylistic rules are
            // enabled, so this never comments on the code itself. See eslint.config.mjs.
            "label": "lint",
            "type": "process",
            "command": "npm",
            "args": ["run", "lint"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            // Checks the JSDoc comments in src/ — tag order, missing types, and a documented
            // parameter name that the signature does not have. Needs nothing installed; see
            // test/checkdoc.mjs for what it does and does not cover.
            "label": "checkdoc",
            "type": "process",
            "command": "npm",
            "args": ["run", "checkdoc"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "checkdoc",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^\\s+(\\S+):(\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            // Checks the JSDoc in just the file in the active editor.
            "label": "checkdoc (current file)",
            "type": "process",
            "command": "node",
            "args": ["test/checkdoc.mjs", "${relativeFile}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "checkdoc",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^\\s+(\\S+):(\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            // Type-checks the JSDoc in src/ against the code, failing only on the codes that mean
            // a comment is wrong. See test/checktypes.mjs for what is gated and why.
            "label": "checktypes",
            "type": "process",
            "command": "npm",
            "args": ["run", "checktypes"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "checktypes",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(\\S+):(\\d+): (TS\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "code": 3,
                    "message": 4
                }
            }
        },
        {
            // The same, plus every diagnostic the gate ignores - the type-model noise that typing
            // the DXF entity model would address. A survey, not a gate.
            "label": "checktypes (all)",
            "type": "process",
            "command": "npm",
            "args": ["run", "checktypes", "--", "--all"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Regenerates docs/api.md from the JSDoc on the public exports. The result is
            // committed, and CI fails if a push leaves it stale, so run this after changing a
            // doc comment on anything reachable from src/index.js.
            "label": "docs",
            "type": "process",
            "command": "npm",
            "args": ["run", "docs"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Applies the same rules in place. Review the diff: src/parser/ and src/RBTree.js are
            // forks, and formatting them is what makes their upstream diffs harder to read.
            "label": "format",
            "type": "process",
            "command": "npm",
            "args": ["run", "format"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            // Formats just the file in the active editor.
            "label": "format (current file)",
            "type": "process",
            "command": "npx",
            "args": ["eslint", "--fix", "${relativeFile}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            // Compiles test/types/consumer.ts against the published declarations. The $tsc matcher
            // turns the output into clickable diagnostics; paths are relative to the workspace.
            "label": "typecheck",
            "type": "process",
            "command": "npm",
            "args": ["run", "typecheck"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$tsc"]
        }
    ],
    "inputs": [
        {
            "id": "dxfQuery",
            "type": "promptString",
            "description": "Python expression, evaluated per DXF file",
            "default": "sorted(types())"
        },
        {
            "id": "corpusQuery",
            "type": "promptString",
            "description": "A file to hash, a sha256 prefix, or part of a name or note"
        },
        {
            "id": "dxfPath",
            "type": "promptString",
            "description": "DXF file to render as SVG",
            "default": "test/fixtures/dimension-linear.dxf"
        }
    ]
}
