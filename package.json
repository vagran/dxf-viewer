{
    "name": "dxf-viewer",
    "version": "1.0.48",
    "description": "JavaScript DXF file viewer",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "author": "Artyom Lebedev<artyom.lebedev@gmail.com>",
    "license": "MPL-2.0",
    "repository": "https://github.com/vagran/dxf-viewer",
    "type": "module",
    "keywords": [
        "dxf",
        "viewer",
        "javascript",
        "webgl",
        "html5",
        "cad"
    ],
    "scripts": {
        "test": "node --test \"test/**/*.test.mjs\"",
        "lint": "eslint .",
        "format": "eslint --fix .",
        "smoke": "node test/smoke.mjs",
        "svg": "node --max-old-space-size=6144 test/svg.mjs",
        "query": "python3 test/tools/dxfq.py",
        "typecheck": "npm --prefix test/types install --no-package-lock --silent && tsc -p test/types"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE",
        "CONTRIBUTORS",
        "CONTRIBUTING.md"
    ],
    "dependencies": {
        "@types/three": "^0.186.0",
        "earcut": "^3.0.0",
        "loglevel": "^1.9.1",
        "opentype.js": "^1.3.4",
        "three": "^0.186.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.10.0",
        "typescript": "^7.0.2"
    }
}
